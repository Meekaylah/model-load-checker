<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>

    <!-- .NET 10 downloads HTTP responses in small pieces ("streaming") by default.
         We always want the whole sample file, and getting it in one piece is about
         twice as fast for the 21 MB sample. -->
    <WasmEnableStreamingResponse>false</WasmEnableStreamingResponse>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModelChecker.Core\ModelChecker.Core.csproj" />
  </ItemGroup>

</Project>
